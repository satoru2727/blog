---
// src/components/Header.astro
// Global header component
// Displays the site logo/title and main navigation
// RELEVANT FILES: src/layouts/Layout.astro

---

<header class="border-b border-gray-200 bg-white">
  <div class="container mx-auto px-4 py-4 flex justify-between items-center">
    <a href="/" class="text-xl font-bold text-gray-900 hover:text-gray-700">
      My Astro Blog
    </a>
    <nav>
      <ul class="flex space-x-6 text-sm font-medium text-gray-600">
        <li>
          <a href="/" class="hover:text-gray-900 transition-colors">Home</a>
        </li>
        <li>
          <a href="/blog" class="hover:text-gray-900 transition-colors">Blog</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
