---
// src/components/Header.astro
// Global header component
// Displays the site logo/title and main navigation
// RELEVANT FILES: src/layouts/Layout.astro

---

<header class="border-b border-[color:var(--c-border)] bg-[color:var(--c-bg)]">
	<div class="container mx-auto flex items-center justify-between px-4 py-4">
		<a href="/" class="text-xl font-bold text-[color:var(--c-text)]">
			My Astro Blog
		</a>
		<nav>
			<ul class="flex space-x-6 text-sm font-medium text-[color:var(--c-muted)]">
				<li>
					<a href="/" class="transition-colors hover:text-[color:var(--c-text)]">Home</a>
				</li>
				<li>
					<a href="/blog" class="transition-colors hover:text-[color:var(--c-text)]">Blog</a>
				</li>
				<li>
					<a href="/tags" class="transition-colors hover:text-[color:var(--c-text)]">Tags</a>
				</li>
			</ul>
		</nav>
	</div>
</header>
