---
// src/components/TagList.astro
// Component to display a list of tags
// Used in blog posts and tag overview pages to provide navigation by category
// RELEVANT FILES: src/layouts/BlogPost.astro, src/pages/tags/index.astro

interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

<div class="flex flex-wrap gap-2">
	{tags.map((tag) => (
		<a
			href={`/tags/${tag}`}
			class="inline-flex items-center rounded-full border border-[color:var(--c-border)] bg-[color:var(--c-surface-2)] px-3 py-1 text-sm text-[color:var(--c-text)]"
		>
			#{tag}
		</a>
	))}
</div>
