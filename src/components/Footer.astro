---
// src/components/Footer.astro
// Global footer component
// Displays copyright information and secondary links
// RELEVANT FILES: src/layouts/Layout.astro

const today = new Date();
---

<footer class="mt-auto border-t border-[color:var(--c-border)] bg-[color:var(--c-bg)]">
	<div class="container mx-auto px-4 py-8 text-center text-sm text-[color:var(--c-muted)]">
		<p>&copy; {today.getFullYear()} My Astro Blog. All rights reserved.</p>
		<div class="mt-4 flex justify-center space-x-4">
			<!-- Social links placeholder -->
			<a href="#" class="transition-colors hover:text-[color:var(--c-text)]">Twitter</a>
			<a href="#" class="transition-colors hover:text-[color:var(--c-text)]">GitHub</a>
		</div>
	</div>
</footer>
