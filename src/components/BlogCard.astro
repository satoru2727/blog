---
export interface Props {
  title: string;
  description?: string;
  category: string;
  tags?: string[];
  pubDate: Date;
  ogpImage?: string; // Changed from heroImage to ogpImage
  slug: string;
  isNew?: boolean;
  size?: 'sm' | 'md' | 'lg';
  orientation?: 'vertical' | 'horizontal';
}

const { 
  title, 
  description, 
  category, 
  tags = [], 
  pubDate, 
  ogpImage, // Changed from heroImage to ogpImage
  slug,
  isNew = false,
  size = 'md',
  orientation = 'vertical'
} = Astro.props;

// 日付が7日以内の場合は新着とする (If the date is within 7 days, it is considered new)
const isNewPost = isNew || (new Date().getTime() - pubDate.getTime()) < 7 * 24 * 60 * 60 * 1000;

// サイズに応じたクラス (Classes based on size)
const sizeClasses = {
  sm: 'w-80',
  md: 'w-96',
  lg: 'w-[28rem]'
};

// 水平レイアウトのクラス (Horizontal layout classes)
const horizontalClasses = orientation === 'horizontal' 
  ? 'card-side max-w-2xl' 
  : '';

const cardClasses = `card bg-base-100 ${sizeClasses[size]} ${horizontalClasses} shadow-sm hover:shadow-lg transition-shadow duration-300`;
---

<div class={cardClasses}>
  <figure class={orientation === 'horizontal' ? 'w-48 min-w-48' : 'aspect-video overflow-hidden'}>
    {ogpImage ? ( /* Changed from heroImage to ogpImage */
      <img
        src={ogpImage} /* Changed from heroImage to ogpImage */
        alt={title}
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
      />
    ) : (
      <div class="w-full h-full bg-gradient-to-br from-gray-200 to-gray-300 flex items-center justify-center">
        <span class="text-gray-500 text-lg font-medium">No Image</span>
      </div>
    )}
  </figure>
  <div class="card-body">
    <h2 class={`card-title font-bold line-clamp-2 ${size === 'sm' ? 'text-base' : size === 'lg' ? 'text-xl' : 'text-lg'}`}>
      <a href={`/blog/${slug}`} class="hover:text-primary transition-colors">
        {title}
      </a>
      {isNewPost && (
        <div class="badge badge-secondary text-xs">NEW</div>
      )}
    </h2>
    
    {description && (
      <p class={`text-base-content/70 line-clamp-3 mb-2 ${size === 'sm' ? 'text-xs' : 'text-sm'}`}>
        {description}
      </p>
    )}
    
    <div class="flex items-center justify-between mb-4">
      <span class="badge badge-outline text-xs">
        {category}
      </span>
      <time class="text-xs text-base-content/50">
        {pubDate.toLocaleDateString('ja-JP')}
      </time>
    </div>
    
    {tags.length > 0 && (
      <div class="card-actions justify-end">
        {tags.slice(0, orientation === 'horizontal' ? 2 : 3).map((tag) => (
          <div class="badge badge-outline text-xs">
            {tag}
          </div>
        ))}
        {tags.length > (orientation === 'horizontal' ? 2 : 3) && (
          <div class="badge badge-outline text-xs">
            +{tags.length - (orientation === 'horizontal' ? 2 : 3)}
          </div>
        )}
      </div>
    )}
  </div>
</div>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
