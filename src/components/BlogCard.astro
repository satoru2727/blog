---
import { processHeroImage } from '../../utils/processHeroImage';
export interface Props {
  title: string;
  description?: string;
  category: string;
  tags?: string[];
  pubDate: Date;
  slug: string;
  isNew?: boolean;
  size?: 'sm' | 'md' | 'lg';
  orientation?: 'vertical' | 'horizontal';
}

const { 
  title, 
  description, 
  category, 
  tags = [], 
  pubDate, 
  slug,
  isNew = false,
  size = 'md',
  orientation = 'vertical'
} = Astro.props;

const imageSrc = await processHeroImage({ title, category, slug });

// 日付が7日以内の場合は新着とする
const isNewPost = isNew || (new Date().getTime() - pubDate.getTime()) < 7 * 24 * 60 * 60 * 1000;

// サイズに応じたクラス
const sizeClasses = {
  sm: 'w-80',
  md: 'w-96',
  lg: 'w-[28rem]'
};

// 水平レイアウトのクラス
const horizontalClasses = orientation === 'horizontal' 
  ? 'card-side max-w-2xl' 
  : '';

const cardClasses = `card bg-base-100 ${sizeClasses[size]} ${horizontalClasses} shadow-sm hover:shadow-lg transition-shadow duration-300`;
---

<div class={cardClasses}>
  <figure class={orientation === 'horizontal' ? 'w-48 min-w-48' : 'aspect-video overflow-hidden'}>
    <img
      src={imageSrc}
      alt={`Hero image for ${title}`}
      class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
      onerror="this.style.display='none'; const fallback = this.parentElement.querySelector('.hero-image-fallback'); if (fallback) fallback.style.display='flex';"
    />
    <div class="hero-image-fallback" style="display:none; width:100%; height:100%; background-color:#f0f0f0; align-items:center; justify-content:center;">
      <span style="color:#555; font-size:1rem;">Image not available</span>
    </div>
  </figure>
  <div class="card-body">
    <h2 class={`card-title font-bold line-clamp-2 ${size === 'sm' ? 'text-base' : size === 'lg' ? 'text-xl' : 'text-lg'}`}>
      <a href={`/blog/${slug}`} class="hover:text-primary transition-colors">
        {title}
      </a>
      {isNewPost && (
        <div class="badge badge-secondary text-xs">NEW</div>
      )}
    </h2>
    
    {description && (
      <p class={`text-base-content/70 line-clamp-3 mb-2 ${size === 'sm' ? 'text-xs' : 'text-sm'}`}>
        {description}
      </p>
    )}
    
    <div class="flex items-center justify-between mb-4">
      <span class="badge badge-outline text-xs">
        {category}
      </span>
      <time class="text-xs text-base-content/50">
        {pubDate.toLocaleDateString('ja-JP')}
      </time>
    </div>
    
    {tags.length > 0 && (
      <div class="card-actions justify-end">
        {tags.slice(0, orientation === 'horizontal' ? 2 : 3).map((tag) => (
          <div class="badge badge-outline text-xs">
            {tag}
          </div>
        ))}
        {tags.length > (orientation === 'horizontal' ? 2 : 3) && (
          <div class="badge badge-outline text-xs">
            +{tags.length - (orientation === 'horizontal' ? 2 : 3)}
          </div>
        )}
      </div>
    )}
  </div>
</div>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
