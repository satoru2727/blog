---
// src/layouts/Layout.astro
// Base layout component for the application
// Provides a consistent HTML structure and imports global styles (Tailwind CSS)
// RELEVANT FILES: src/styles/global.css, src/pages/index.astro

import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = 'Astro Blog' } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
