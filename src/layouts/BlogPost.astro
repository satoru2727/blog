---
// src/layouts/BlogPost.astro
// Layout for individual blog post pages
// Formats the blog post metadata and provides a container for the content
// RELEVANT FILES: src/pages/blog/[...id].astro, src/content.config.ts

import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import TagList from '../components/TagList.astro';
import Layout from './Layout.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	category?: string;
	headings?: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, heroImage, tags, category, headings } =
	Astro.props;
---

<Layout title={title} description={description} image={`/og/${Astro.url.pathname.replace(/^\/blog\//, '').replace(/\/$/, '')}.png`}>
	<article class="container mx-auto max-w-3xl p-4">
		{heroImage && (
			<img
				src={heroImage}
				alt=""
				class="mb-8 h-auto w-full rounded-none border border-[color:var(--c-border)]"
			/>
		)}
		<header class="mb-8">
			<h1 class="mb-2 text-4xl font-bold text-[color:var(--c-text)]">{title}</h1>
			<div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-[color:var(--c-muted)]">
				<time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('ja-JP')}</time>
				{updatedDate && (
					<span>
						(更新日:{' '}
						<time datetime={updatedDate.toISOString()}>{updatedDate.toLocaleDateString('ja-JP')}</time>)
					</span>
				)}
				{category && (
					<span class="inline-flex items-center rounded-full border border-[color:var(--c-border)] bg-[color:var(--c-surface-2)] px-2 py-1 text-xs">
						<a href={`/categories/${encodeURIComponent(category)}`}>{category}</a>
					</span>
				)}
			</div>
			{tags && tags.length > 0 && <TagList tags={tags} />}
		</header>

		<div class="prose prose-lg max-w-none prose-headings:scroll-mt-24 prose-headings:font-[var(--font-sans-heading)] prose-headings:text-[color:var(--c-text)] prose-p:text-[color:var(--c-text)] prose-li:text-[color:var(--c-text)] prose-strong:text-[color:var(--c-text)] prose-a:text-[color:var(--c-link)] prose-a:no-underline hover:prose-a:no-underline prose-blockquote:border-l-[color:var(--c-border)] prose-blockquote:bg-[color:var(--c-surface-2)] prose-blockquote:py-1 prose-blockquote:px-4 prose-blockquote:text-[color:var(--c-text)] prose-code:bg-[color:var(--c-surface-2)] prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:text-[color:var(--c-text)] prose-pre:bg-[color:var(--c-surface-2)] prose-pre:border prose-pre:border-[color:var(--c-border)]">
			{headings && headings.length > 0 && (
				<nav aria-label="目次" class="mb-8">
					<div class="rounded-[var(--radius-md)] border border-[color:var(--c-border)] bg-[color:var(--c-surface-2)] p-4">
						<h2 class="mb-3 text-lg font-semibold text-[color:var(--c-text)]">目次</h2>
						<ul class="space-y-2">
							{headings
								.filter((heading) => heading.depth >= 2 && heading.depth <= 3)
								.map((heading) => (
									<li>
										<a
											href={`#${heading.slug}`}
											class="inline-block rounded px-2 py-1 text-[color:var(--c-text)] transition-colors hover:bg-[color:var(--c-surface)]"
										>
											{heading.text}
										</a>
									</li>
								))}
						</ul>
					</div>
				</nav>
			)}
			<slot />
		</div>

		<div class="mt-12 border-t border-[color:var(--c-border)] pt-8">
			<a href="/">← ホームに戻る</a>
		</div>
	</article>
</Layout>
