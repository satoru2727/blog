---
// src/pages/index.astro
// The landing page of the blog
// Lists all blog posts sorted by publication date
// RELEVANT FILES: src/layouts/Layout.astro, src/content.config.ts

import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main class="container mx-auto p-4 max-w-4xl">
		<header class="mb-12">
			<div class="font-[var(--font-sans-heading)]">
				<h1 class="mb-2 text-5xl font-extrabold text-[color:var(--c-text)]">Astro Blog</h1>
				<p class="text-lg text-[color:var(--c-muted)]">
					Astro v5 & Tailwind CSS で構築された個人ブログ
				</p>
			</div>
		</header>

		<section class="rounded-[var(--radius-md)] border border-[color:var(--c-border)] bg-[color:var(--c-surface)] p-6">
			<h2 class="mb-6 border-b border-[color:var(--c-border)] pb-2 text-2xl font-bold">
				最新の投稿
			</h2>
			<ul class="space-y-8">
				{posts.map((post) => (
					<li class="group">
						<a
							href={`/blog/${post.id}/`}
							class="block rounded-[var(--radius-md)] p-3 transition-colors hover:bg-[color:var(--c-surface-2)]"
						>
							<time datetime={post.data.pubDate.toISOString()} class="text-sm text-[color:var(--c-muted)]">
								{post.data.pubDate.toLocaleDateString('ja-JP')}
							</time>
							<h3 class="mt-1 text-2xl font-semibold text-[color:var(--c-link)]">
								{post.data.title}
							</h3>
							<p class="mt-2 line-clamp-2 text-[color:var(--c-muted)]">
								{post.data.description}
							</p>
						</a>
					</li>
				))}
			</ul>
		</section>
	</main>
</Layout>