---
// src/pages/tags/index.astro
// Page that displays a list of all tags used in the blog
// Allows users to discover content by browsing through available categories
// RELEVANT FILES: src/layouts/Layout.astro, src/components/TagList.astro

import Layout from '../../layouts/Layout.astro';
import TagList from '../../components/TagList.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort();
---

<Layout title="タグ一覧" description="ブログで使用されているすべてのタグの一覧です。">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold mb-8">タグ一覧</h1>
    
    {tags.length > 0 ? (
      <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
        <TagList tags={tags} />
      </div>
    ) : (
      <p class="text-gray-500">タグがまだありません。</p>
    )}
    
    <div class="mt-12">
      <a href="/" class="text-blue-600 hover:underline">← ホームに戻る</a>
    </div>
  </div>
</Layout>
