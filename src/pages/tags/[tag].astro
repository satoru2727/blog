---
// src/pages/tags/[tag].astro
// Dynamic route for displaying blog posts associated with a specific tag
// Helps users find related content efficiently
// RELEVANT FILES: src/layouts/Layout.astro, src/content.config.ts

import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))];

	return uniqueTags.map((tag) => {
		const filteredPosts = allPosts
			.filter((post) => post.data.tags?.includes(tag))
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
		return {
			params: { tag },
			props: { posts: filteredPosts },
		};
	});
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Layout title={`タグ: ${tag}`} description={`「${tag}」タグが付いた記事の一覧です。`}>
	<main class="container mx-auto max-w-3xl p-4">
		<div class="mb-8">
			<h1 class="text-3xl font-bold text-[color:var(--c-text)]">
				タグ: <span class="text-[color:var(--c-link)]">#{tag}</span>
			</h1>
			<p class="mt-2 text-[color:var(--c-muted)]">{posts.length} 件の記事が見つかりました</p>
		</div>

		<section class="rounded-[var(--radius-md)] border border-[color:var(--c-border)] bg-[color:var(--c-surface)] p-6">
			<ul class="space-y-8">
				{posts.map((post) => (
					<li class="group">
						<a
							href={`/blog/${post.id}/`}
							class="block rounded-[var(--radius-md)] p-3 transition-colors hover:bg-[color:var(--c-surface-2)]"
						>
							<time datetime={post.data.pubDate.toISOString()} class="text-sm text-[color:var(--c-muted)]">
								{post.data.pubDate.toLocaleDateString('ja-JP')}
							</time>
							<h2 class="text-2xl font-bold text-[color:var(--c-text)]">{post.data.title}</h2>
							<p class="mt-2 line-clamp-2 text-[color:var(--c-muted)]">
								{post.data.description}
							</p>
						</a>
					</li>
				))}
			</ul>
		</section>

		<div class="mt-12">
			<a href="/tags">← すべてのタグを見る</a>
		</div>
	</main>
</Layout>
