---
import { getCollection } from 'astro:content';
import { processHeroImage } from '../utils/processHeroImage';

const posts = await getCollection('blog');

// 各投稿のヒーローイメージを処理
const processedPosts = posts.map((post) => {
  const heroImage = processHeroImage({
    title: post.data.title,
    category: post.data.category,
    heroImage: post.data.heroImage,
  });
  
  return {
    ...post,
    data: {
      ...post.data,
      heroImage,
    }
  };
});

// 日付順にソート
const sortedPosts = processedPosts.sort((a, b) => 
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>ブログ一覧</title>
    <meta name="description" content="最新のブログ記事一覧" />
  </head>
  <body class="min-h-screen bg-gray-50">
    <div class="max-w-6xl mx-auto py-8 px-4">
      <header class="mb-12 text-center">
        <h1 class="text-5xl font-bold text-gray-900 mb-4">
          Blog
        </h1>
        <p class="text-lg text-gray-600">
          最新の記事をお楽しみください
        </p>
      </header>
      
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {sortedPosts.map((post) => (
          <article class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
            <!-- ヒーローイメージ -->
            {post.data.heroImage && (
              <div class="aspect-video overflow-hidden">
                <img 
                  src={post.data.heroImage} 
                  alt={post.data.title}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                />
              </div>
            )}
            
            <div class="p-6">
              <!-- カテゴリとメタ情報 -->
              <div class="flex items-center justify-between mb-3">
                <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm font-medium">
                  {post.data.category}
                </span>
                <time class="text-gray-500 text-sm">
                  {post.data.pubDate.toLocaleDateString('ja-JP')}
                </time>
              </div>
              
              <!-- タイトル -->
              <h2 class="text-xl font-bold text-gray-900 mb-3 line-clamp-2">
                <a href={`/blog/${post.slug}`} class="hover:text-blue-600 transition-colors">
                  {post.data.title}
                </a>
              </h2>
              
              <!-- 説明 -->
              {post.data.description && (
                <p class="text-gray-600 mb-4 line-clamp-3">
                  {post.data.description}
                </p>
              )}
              
              <!-- タグ -->
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {post.data.tags.slice(0, 3).map((tag: string) => (
                    <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-xs">
                      #{tag}
                    </span>
                  ))}
                  {post.data.tags.length > 3 && (
                    <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-xs">
                      +{post.data.tags.length - 3}
                    </span>
                  )}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </body>
</html>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
