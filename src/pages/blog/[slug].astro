---
import { getCollection } from 'astro:content';
import { processOgpImage } from '../../utils/processOgpImage'; // Updated import

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  
  // 各投稿のOGPイメージを処理 (Process OGP image for each post)
  const processedPosts = await Promise.all(posts.map(async (post) => {
    const ogpImage = await processOgpImage({ // Call processOgpImage, rename variable
      slug: post.slug,
      ogpImage: post.data.ogpImage, // Pass ogpImage from frontmatter
      heroImage: post.data.heroImage, // Pass heroImage for fallback
      // title and category are not strictly needed by processOgpImage, 
      // but keeping them if other parts of your build might expect them indirectly.
      // If not, they can be removed here.
      title: post.data.title, 
      category: post.data.category,
    });
    
    return {
      params: { slug: post.slug },
      props: { 
        post: {
          ...post,
          data: {
            ...post.data,
            ogpImage, // Set ogpImage in props
          }
        }
      },
    };
  }));

  return processedPosts;
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{post.data.title}</title>
    {post.data.description && <meta name="description" content={post.data.description} />}
    
    <!-- OGP meta tags -->
    <meta property="og:title" content={post.data.title} />
    {post.data.description && <meta property="og:description" content={post.data.description} />}
    {post.data.ogpImage && <meta property="og:image" content={new URL(post.data.ogpImage, Astro.url).href} />} {/* Use ogpImage */}
    <meta property="og:type" content="article" />
  </head>
  <body class="min-h-screen bg-gray-50">
    <article class="max-w-4xl mx-auto py-8 px-4">
      <!-- OGPイメージ (OGP Image) -->
      {post.data.ogpImage && ( /* Use ogpImage */
        <div class="mb-8 rounded-lg overflow-hidden shadow-lg">
          <img 
            src={post.data.ogpImage} /* Use ogpImage */
            alt={post.data.title}
            class="w-full h-64 sm:h-80 object-cover"
          />
        </div>
      )}
      
      <!-- メタ情報 (Meta information) -->
      <header class="mb-8">
        <div class="flex items-center gap-4 mb-4">
          <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm font-medium">
            {post.data.category}
          </span>
          <time class="text-gray-600 text-sm">
            {post.data.pubDate.toLocaleDateString('ja-JP')}
          </time>
        </div>
        
        <h1 class="text-4xl font-bold text-gray-900 mb-4">
          {post.data.title}
        </h1>
        
        {post.data.description && (
          <p class="text-lg text-gray-600 mb-6">
            {post.data.description}
          </p>
        )}
        
        <!-- タグ (Tags) -->
        {post.data.tags && (
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag: string) => (
              <span class="px-2 py-1 bg-gray-200 text-gray-700 rounded text-sm">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </header>
      
      <!-- コンテンツ (Content) -->
      <div class="prose prose-lg max-w-none">
        <Content />
      </div>
    </article>
  </body>
</html>
