{
	"name": "blog",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check",
		"lint": "biome lint .",
		"lint:fix": "biome check . --write",
		"format": "biome format . --write",
		"test": "pnpm test:a11y",
		"test:a11y": "pnpm build && playwright test",
		"pw:install": "playwright install chromium",
		"pw:install-deps": "playwright install-deps chromium",
		"prepare": "husky",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/rss": "^4.0.14",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"astro": "^5.16.9",
		"satori": "^0.18.3",
		"sharp": "^0.34.5",
		"tailwindcss": "^4.1.18"
	},
	"volta": {
		"node": "24.12.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "sharp"]
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,jsonc,css,graphql,gql}": ["biome check --write"],
		"*.astro": ["biome format --write", "biome lint"]
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.6",
		"@axe-core/playwright": "^4.10.2",
		"@biomejs/biome": "^1.9.4",
		"@playform/compress": "^0.2.1",
		"@playform/inline": "^0.1.2",
		"@playwright/test": "^1.50.1",
		"@types/node": "^25.0.8",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"typescript": "^5.9.3"
	}
}
